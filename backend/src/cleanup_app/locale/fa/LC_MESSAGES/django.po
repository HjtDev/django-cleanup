msgstr "هیچ فایل بدون مرجعی یافت نشد."

#: templates/admin/cleanup_app/orphanfile/delete_confirmation.html:17
msgid "Confirm deletion"
msgstr "تأیید حذف"

#: templates/admin/cleanup_app/orphanfile/delete_confirmation.html:24
#, python-format
msgid ""
"\n"
"      Are you sure you want to permanently delete %(counter)s file? This "
"cannot be undone.\n"
"    "
msgid_plural ""
"\n"
"      Are you sure you want to permanently delete %(counter)s files? This "
"cannot be undone.\n"
"    "
msgstr[0] "\n      آیا مطمئن هستید که می‌خواهید %(counter)s فایل را برای همیشه حذف کنید؟ این کار قابل بازگشت نیست.\n    "
msgstr[1] "\n      آیا مطمئن هستید که می‌خواهید %(counter)s فایل را برای همیشه حذف کنید؟ این کار قابل بازگشت نیست.\n    "

#: templates/admin/cleanup_app/orphanfile/delete_confirmation.html:31
#, python-format
msgid ""
"\n"
"      This will free approximately %(total)s.\n"
"    "
msgstr "\n      این کار حدود %(total)s فضا آزاد خواهد کرد.\n    "

#: templates/admin/cleanup_app/orphanfile/delete_confirmation.html:49
msgid "Yes, delete these files"
msgstr "بله، این فایل‌ها حذف شوند"

#: templates/admin/cleanup_app/orphanfile/delete_confirmation.html:50
msgid "Cancel"
msgstr "لغو"
