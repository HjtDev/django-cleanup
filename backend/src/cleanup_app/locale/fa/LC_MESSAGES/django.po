msgstr "فایل‌های بدون مرجع"

#: admin.py:254
msgid "Orphan scan cache cleared — results refreshed."
msgstr "حافظهٔ پنهان اسکن فایل‌های بدون مرجع پاک شد — نتایج به‌روزرسانی شدند."

#: admin.py:309
msgid "Are you sure?"
msgstr "آیا مطمئن هستید؟"

#: admin.py:333
msgid "No files were selected."
msgstr "هیچ فایلی انتخاب نشده است."

#: admin.py:343
#, python-format
msgid ""
"These are no longer valid orphan candidates (already deleted, referenced "
"again, or excluded) — rescan and try again: %(paths)s"
msgstr "این موارد دیگر فایل بدون مرجع معتبر نیستند (قبلاً حذف شده‌اند، دوباره ارجاع داده شده‌اند یا مستثنا شده‌اند) — دوباره اسکن کنید و امتحان کنید: %(paths)s"

#: admin.py:357
#, python-format
msgid "Deleted %(count)d file, freeing %(bytes)s."
msgid_plural "Deleted %(count)d files, freeing %(bytes)s."
msgstr[0] "%(count)d فایل حذف شد و %(bytes)s فضا آزاد شد."
msgstr[1] "%(count)d فایل حذف شد و %(bytes)s فضا آزاد شد."

#: admin.py:367
#, python-format
msgid ""
"%(count)d file could not be deleted — see the cleanup run history for "
"details."
msgid_plural ""
"%(count)d files could not be deleted — see the cleanup run history for "
"details."
msgstr[0] "%(count)d فایل حذف نشد — برای جزئیات به تاریخچهٔ اجراهای پاک‌سازی مراجعه کنید."
msgstr[1] "%(count)d فایل حذف نشد — برای جزئیات به تاریخچهٔ اجراهای پاک‌سازی مراجعه کنید."

