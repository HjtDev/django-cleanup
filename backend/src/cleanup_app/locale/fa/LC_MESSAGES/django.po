msgstr "پیشخوان مدیریت جنگو"

#: templates/admin/cleanup_app/orphanfile/change_list.html:17
#: templates/admin/cleanup_app/orphanfile/delete_confirmation.html:15
msgid "Home"
msgstr "خانه"

#: templates/admin/cleanup_app/orphanfile/change_list.html:27
msgid ""
"The scan hit its configured file limit — not every orphaned file is shown "
"below. Narrow SCAN_ROOTS or raise MAX_FILES_PER_RUN to see the rest."
msgstr "اسکن به سقف تعداد فایل تنظیم‌شده رسید — همهٔ فایل‌های بدون مرجع در زیر نمایش داده نشده‌اند. برای دیدن باقی موارد، SCAN_ROOTS را محدودتر کنید یا MAX_FILES_PER_RUN را افزایش دهید."

#: templates/admin/cleanup_app/orphanfile/change_list.html:32
#, python-format
msgid ""
"\n"
"      %(counter)s orphaned file found.\n"
"    "
msgid_plural ""
"\n"
"      %(counter)s orphaned files found.\n"
"    "
msgstr[0] "\n      %(counter)s فایل بدون مرجع یافت شد.\n    "
msgstr[1] "\n      %(counter)s فایل بدون مرجع یافت شد.\n    "

#: templates/admin/cleanup_app/orphanfile/change_list.html:39
#, python-format
msgid ""
"\n"
"      Scanned %(files_scanned)s files in total &mdash; %(total)s "
"reclaimable.\n"
"    "
msgstr "\n      در مجموع %(files_scanned)s فایل اسکن شد &mdash; %(total)s قابل بازیابی.\n    "

#: templates/admin/cleanup_app/orphanfile/change_list.html:48
msgid "Rescan"
msgstr "اسکن مجدد"

#: templates/admin/cleanup_app/orphanfile/change_list.html:50
msgid "Delete selected"
msgstr "حذف موارد انتخاب‌شده"

#: templates/admin/cleanup_app/orphanfile/change_list.html:59
