# Copy to playground/.env and pass --env-file playground/.env to docker compose.
# Every value has a working default baked into docker-compose.yml / config/settings.py — this
# file exists only for the one knob worth flipping mid-session.

# Set to true (and bring the `worker` service up) to exercise the USE_CELERY path — POST /runs/
# should then return 202 with a PENDING run instead of running synchronously. False by default
# so the default `docker compose up` proves the no-Celery, fully-synchronous path first.
CLEANUP_USE_CELERY=false
